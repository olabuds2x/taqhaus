# Web3Forms Configuration
# Get your free access key from https://web3forms.com
# 1. Go to https://web3forms.com
# 2. Enter your email address
# 3. Copy the access key they send you
# 4. Create a .env file and paste it below

VITE_WEB3FORMS_KEY=your_access_key_here

# ── $99 Google package (/google) ─────────────────────────────────────────
# Front end (build-time). Leave false until Stripe, the webhook and the
# refund terms are live; the CTA then shows an honest "email us" fallback.
VITE_GOOGLE_CHECKOUT_ENABLED=false
# Google account clients invite as Manager on their Business Profile.
VITE_GOOGLE_MANAGER_EMAIL=

# Server (Vercel project env vars, never VITE_-prefixed)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: use a Stripe Price instead of the inline $99 USD price.
STRIPE_PRICE_ID=
# Optional: 'true' once Stripe Tax is set up.
STRIPE_AUTOMATIC_TAX=false
# Optional: force redirect origin (defaults to the request's origin).
PUBLIC_SITE_URL=https://www.taqhaus.com
# Order emails via Resend (sender domain must be verified in Resend).
RESEND_API_KEY=
ORDER_FROM_EMAIL=TaqHaus <orders@taqhaus.com>
ORDER_NOTIFY_EMAIL=
